  "_notes": {
    "modes": "'smart' = sous-titres intelligents (decoupage adapte, mots importants mis en evidence, placement evitant le visage). 'progressive'/'classic' = styles historiques, conserves tels quels.",
    "personnalisation": "Chaque style expose police, taille, couleurs, contour, ombre, position (margin_v), animation, mots par groupe (words_per_group) et longueur de ligne (max_chars_per_group).",
    "animation": "'none', 'fade' (apparition/disparition douce) ou 'pop' (fade + leger agrandissement du mot mis en evidence).",
    "colors": "Format ASS &HAABBGGRR (alpha puis BGR, pas RGB). &H00FFFFFF = blanc opaque.",
    "alignment": "Numpad ASS: 2 = bas-centre (defaut, laisse de la marge sous margin_v pour eviter l'UI Instagram).",
    "margin_v": "Marge verticale en pixels depuis le bas du cadre 1080x1920 -- volontairement haute pour rester au-dessus des icones Reels."
