.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Generes a l'execution -- pas versionnes.
output/*.mp4
output/results.json
.cache/
/user_projects/
config/gui_settings.json

# Cle API YouTube -- jamais commitee (voir README, section recherche YouTube).
youtube_api_key.txt
# Cle API Claude (news cine, news_story/ai_summary.py) -- jamais commitee.
anthropic_api_key.txt
anthropic_model.txt
# Memoire des news deja exportees (news_story/published.py).
news_publiees.json

# Sorties du build .exe (voir .github/workflows/build-windows-exe.yml et
# build-windows-gui.yml).
dist/
build_tmp/
build/installer_output/
*.spec.bak
clip_farming-windows.zip
ClipFarming-windows.zip

# Videos de test locales
*.mp4
*.mov
*.mkv
!video/**/*.mp4
# La video d'intro ClipsOfStreams est un asset livre avec l'appli (voir
# video/intro.py), pas une video de test -- meme exception que ci-dessus.
!assets/**/*.mp4
# Source fond vert de l'intro, lue par tools/build_intro_asset.py.
!tools/source/*.mp4

.DS_Store

# Donnees locales creees a l'execution quand on lance depuis le depot (en
# version installee, elles vivent dans le dossier de donnees de l'utilisateur).
whisper-models/
clips/

# Voice Studio : projets et voix generees (donnees locales, jamais du code).
